   "source": [
    "# Usando where asignamos la duration_unit a min cuando es \"min\" y a \"season\" cuando es <> min\n",
    "# https://pandas.pydata.org/pandas-doc/stable/reference/api/pandas.Series.where.html\n",
    "df['duration_unit'] = df['duration_unit'].where(df.duration_num.str.endswith('min'), 'season')"
